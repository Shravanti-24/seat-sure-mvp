# Copy to .env and adjust. docker-compose reads this file automatically.
# Nothing in here is a real secret: generate your own before deploying.

# --- Database ---
POSTGRES_DB=seatsure
POSTGRES_USER=seatsure
POSTGRES_PASSWORD=seatsure
DATABASE_URL=jdbc:postgresql://postgres:5432/seatsure
DATABASE_USERNAME=seatsure
DATABASE_PASSWORD=seatsure

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Secrets (generate with: openssl rand -base64 48) ---
JWT_SECRET=replace-me-with-at-least-32-bytes-of-random
TICKET_HMAC_SECRET=replace-me-with-at-least-32-bytes-of-random

# --- Seeded accounts (Flyway hashes these at startup) ---
SEED_ADMIN_PASSWORD=admin12345
SEED_STAFF_PASSWORD=gate12345
SEED_LOADTEST_PASSWORD=loadtest12345

# --- Behaviour ---
HOLD_DURATION_SECONDS=420
QUEUE_BATCH_SIZE=25
QUEUE_TICK_INTERVAL_MS=5000
QUEUE_ADMISSION_TTL_SECONDS=600
QUEUE_ABANDON_AFTER_SECONDS=60
HIGH_DEMAND_SALE_DELAY_MINUTES=2
RATE_LIMIT_ENABLED=true

# --- Frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080
